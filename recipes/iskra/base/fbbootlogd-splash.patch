+    // Iskra: animation timer for the boot splash (opened before entering the null namespace).
+    let mut timer = File::open(format!("/scheme/time/{}", libredox::flag::CLOCK_MONOTONIC))
+        .expect("fbbootlogd: failed to open timer");
+    event_queue
