+    /// Draws straight into the primary framebuffer (ARGB8888, mirrored to the other displays) and
+    /// presents the damage rectangle `f` returns as (x1, y1, x2, y2). Used by fbbootlogd's splash.
+    pub fn draw_raw(
+        &mut self,
+        f: impl FnOnce(&mut [u32], usize, usize, usize) -> (u16, u16, u16, u16),
+    ) -> io::Result<()> {
+        let damage = self.with_console_map(|map| {
+            // SAFETY: the shadow buffer outlives this call and nothing else borrows it meanwhile.
+            let buf = unsafe { &mut *map.offscreen };
+            let (x1, y1, x2, y2) = f(buf, map.stride, map.width, map.height);
+            ClipRect::new(x1, y1, x2, y2)
+        });
+        self.dirty_fb(damage)
+    }
+
     fn dirty_fb(&mut self, damage: ClipRect) -> io::Result<()> {
         for (_crtc, fb, buffer) in &mut self.displays {
             buffer.sync_rect(
