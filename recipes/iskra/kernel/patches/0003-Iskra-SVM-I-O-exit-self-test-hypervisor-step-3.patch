+
+/// Step 3: I/O exits. The guest writes a string to the serial port 0x3F8 one byte at a time; every
+/// `out` exits to the host (all ports intercepted), which collects the byte and resumes the guest
+/// at the next instruction. This is how a VMM emulates a device for a guest.
+fn test_io_exits() -> Result<(), &'static str> {
+    //   0: BE 40 00 00 00   mov esi, 0x40        ; message
+    //   5: 66 BA F8 03      mov dx, 0x3F8        ; COM1 data port
+    //   9: AC               lodsb
+    //  10: 84 C0            test al, al
+    //  12: 74 03            jz 17
+    //  14: EE               out dx, al           -> I/O exit
+    //  15: EB F8            jmp 9
+    //  17: F4               hlt
+    const CODE: [u8; 18] = [
+        0xBE, 0x40, 0x00, 0x00, 0x00, 0x66, 0xBA, 0xF8, 0x03, 0xAC, 0x84, 0xC0, 0x74, 0x03, 0xEE,
+        0xEB, 0xF8, 0xF4,
+    ];
+    const MESSAGE: &[u8] = b"Hello from a guest inside Iskra\0";
+    const COM1: u64 = 0x3F8;
+
+    let guest = PagedGuest::new(&CODE)?;
+    unsafe { core::ptr::copy_nonoverlapping(MESSAGE.as_ptr(), guest.page0_va.add(0x40), MESSAGE.len()) };
+
+    // I/O permission map: 12 KiB of physically contiguous memory, every bit set = intercept every port.
+    let iopm = crate::memory::allocate_p2frame(2, true).ok_or("no frames for I/O permission map")?;
+    let iopm_pa = iopm.base().data() as u64;
+    unsafe {
+        core::ptr::write_bytes(RmmA::phys_to_virt(iopm.base()).data() as *mut u8, 0xFF, 3 * 4096);
+        let v = &guest.vmcb;
+        v.w64(CTRL_IOPM_BASE_PA, iopm_pa);
+        v.w32(CTRL_INST1_INTERCEPT, INTCPT_HLT | INTCPT_SHUTDOWN | INTCPT_IO);
+    }
+
+    let v = &guest.vmcb;
+    let mut out = [0u8; 64];
+    let mut len = 0;
+    for _ in 0..out.len() + 1 {
+        let exit = v.run();
+        match exit {
+            EXIT_IO => {
+                let info1 = unsafe { v.r64(CTRL_EXITINFO1) };
+                let is_in = info1 & 1 != 0;
+                let size = (info1 >> 4) & 0x7; // bit 4: 8-bit, 5: 16-bit, 6: 32-bit
+                let port = info1 >> 16;
+                if is_in || size != 1 || port != COM1 || len == out.len() {
+                    v.log_exit("io exits");
+                    return Err("unexpected I/O access");
+                }
+                out[len] = v.ax() as u8;
+                len += 1;
+                // EXITINFO2 holds the address of the instruction after the OUT.
+                unsafe { v.w64(STATE_RIP, v.r64(CTRL_EXITINFO2)) };
+            }
+            EXIT_HLT => {
+                let text = core::str::from_utf8(&out[..len]).unwrap_or("<not utf-8>");
+                info!("iskra-svm: io exits: guest wrote {} bytes to COM1: {:?}", len, text);
+                return if &out[..len] == &MESSAGE[..MESSAGE.len() - 1] {
+                    Ok(())
+                } else {
+                    Err("guest output differs from its message")
+                };
+            }
+            other => {
+                v.log_exit("io exits");
+                return Err(explain(other));
+            }
+        }
+    }
+    Err("guest did not halt")
+}
