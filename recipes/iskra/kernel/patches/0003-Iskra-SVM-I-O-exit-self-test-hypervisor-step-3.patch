From 93afad10419c3d6e7fe428683e27258e720113a0 Mon Sep 17 00:00:00 2001
From: mattryznar <ryznarmat@gmail.com>
Date: Fri, 27 Nov 2026 17:28:57 +0100
Subject: [PATCH 3/8] Iskra: SVM I/O exit self-test (hypervisor step 3)

The guest prints a string to COM1; every OUT exits to the host through an
all-ports I/O permission map, the host collects the byte and resumes the guest
at EXITINFO2 (next RIP). The 32-bit paged guest setup is shared with the
nested paging test (PagedGuest).
---
 src/arch/x86_shared/svm.rs | 155 +++++++++++++++++++++++++++++--------
 1 file changed, 123 insertions(+), 32 deletions(-)

diff --git a/src/arch/x86_shared/svm.rs b/src/arch/x86_shared/svm.rs
index b6af8c25..aaa8236b 100644
--- a/src/arch/x86_shared/svm.rs
+++ b/src/arch/x86_shared/svm.rs
@@ -12,6 +12,9 @@
 //!    then reads unmapped address 0x5000, which must exit with a nested page fault for 0x5000. The
 //!    host maps a page holding 0xBEEF there and resumes; the guest must finish with AX = 0xBEEF.
 //!    Proves NPT, NPF exits and resuming a guest after an exit (demand mapping).
+//! 3. `test_io_exits`: the guest prints a string to the serial port; every `out` exits to the host,
+//!    which collects the byte and resumes the guest after it. Proves I/O intercepts, the I/O
+//!    permission map and stepping a guest past an emulated instruction.
 //!
 //! VMCB offsets follow FreeBSD's sys/amd64/vmm/amd/vmcb.h (bhyve, BSD-2-Clause) and the AMD APM
 //! vol. 2, appendix B.
@@ -35,15 +38,18 @@ const CTRL_INST1_INTERCEPT: usize = 0x00C;
 const CTRL_INST2_INTERCEPT: usize = 0x010;
 const CTRL_ASID: usize = 0x058;
 const CTRL_TLB_CTRL: usize = 0x05C;
+const CTRL_IOPM_BASE_PA: usize = 0x040;
 const CTRL_EXITCODE: usize = 0x070;
 const CTRL_EXITINFO1: usize = 0x078;
 const CTRL_EXITINFO2: usize = 0x080;
 const CTRL_NP_ENABLE: usize = 0x090;
 const CTRL_N_CR3: usize = 0x0B0;
 const INTCPT_HLT: u32 = 1 << 24;
+const INTCPT_IO: u32 = 1 << 27;
 const INTCPT_SHUTDOWN: u32 = 1 << 31;
 const INTCPT_VMRUN: u32 = 1 << 0; // architecturally required
 const EXIT_HLT: u64 = 0x78;
+const EXIT_IO: u64 = 0x7B;
 const EXIT_NPF: u64 = 0x400;
 const EXIT_INVALID: u64 = u64::MAX;
 
@@ -233,6 +239,51 @@ impl NestedPageTable {
     }
 }
 
+/// A 32-bit protected-mode guest with its own paging on (one 4 MiB identity page), so every access
+/// goes guest-linear -> guest-physical (guest tables) -> host-physical (nested tables), as in a real
+/// VM. (QEMU 8.2's SVM emulation skips nested paging for guests with paging off, which made a
+/// real-mode version of the nested paging test run host memory.)
+///
+/// Guest-physical layout: 0x0000 one page of code and data (`code` at offset 0), 0x1000 the guest
+/// page directory. Nothing else is mapped.
+struct PagedGuest {
+    npt: NestedPageTable,
+    vmcb: Vmcb,
+    page0_va: *mut u8,
+}
+
+impl PagedGuest {
+    fn new(code: &[u8]) -> Result<Self, &'static str> {
+        const GUEST_PD: u64 = 0x1000;
+        let npt = NestedPageTable::new().ok_or("no frame for nested PML4")?;
+        let (page0_pa, page0_va) = zeroed_page().ok_or("no frame for guest page 0")?;
+        let (pd_pa, pd_va) = zeroed_page().ok_or("no frame for guest page directory")?;
+        unsafe {
+            core::ptr::copy_nonoverlapping(code.as_ptr(), page0_va, code.len());
+            // PDE 0: 4 MiB page at guest-physical 0, present | writable | page size.
+            pd_va.cast::<u32>().write_unaligned(0x0000_0083);
+        }
+        npt.map_4k(0, page0_pa).ok_or("no frame for nested page tables")?;
+        npt.map_4k(GUEST_PD, pd_pa).ok_or("no frame for nested page tables")?;
+
+        let v = Vmcb::real_mode(0).ok_or("no frame for VMCB")?;
+        unsafe {
+            const CODE32: u16 = 0x0C9B; // G, D, present, S, type 0xB
+            const DATA32: u16 = 0x0C93; // G, B, present, S, type 0x3
+            v.seg(SEG_CS, 0x08, CODE32, 0xFFFF_FFFF, 0);
+            for off in [SEG_ES, SEG_SS, SEG_DS, SEG_FS, SEG_GS] {
+                v.seg(off, 0x10, DATA32, 0xFFFF_FFFF, 0);
+            }
+            v.w64(STATE_CR0, 0x8000_0011); // PG | ET | PE
+            v.w64(STATE_CR3, GUEST_PD);
+            v.w64(STATE_CR4, 0x10); // PSE: 4 MiB pages
+            v.w64(CTRL_NP_ENABLE, 1);
+            v.w64(CTRL_N_CR3, npt.pml4);
+        }
+        Ok(Self { npt, vmcb: v, page0_va })
+    }
+}
+
 pub fn selftest() {
     if let Err(why) = svm_supported() {
         info!("iskra-svm: skipped: {}", why);
@@ -254,6 +305,7 @@ pub fn selftest() {
         info!("iskra-svm: nested paging: skipped: CPU has no NPT (CPUID 8000_000Ah EDX bit 0)");
     } else {
         report("nested paging", &test_nested_paging());
+        report("io exits", &test_io_exits());
     }
 }
 
