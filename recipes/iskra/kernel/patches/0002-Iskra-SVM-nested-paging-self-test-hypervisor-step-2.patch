+    /// A fresh VMCB for a 16-bit real-mode guest whose code starts at CS:IP = 0:0, with CS
+    /// based at `cs_base` (a host address without NPT, a guest address with it).
+    fn real_mode(cs_base: u64) -> Option<Self> {
+        let (pa, va) = zeroed_page()?;
+        let v = Vmcb { pa, va };
+        unsafe {
+            // Control: exit on every exception, on HLT and on shutdown (triple fault).
+            v.w32(CTRL_EXC_INTERCEPT, 0xFFFF_FFFF);
+            v.w32(CTRL_INST1_INTERCEPT, INTCPT_HLT | INTCPT_SHUTDOWN);
+            v.w32(CTRL_INST2_INTERCEPT, INTCPT_VMRUN);
+            v.w32(CTRL_ASID, 1);
+            v.w32(CTRL_TLB_CTRL, 1); // flush entire TLB on every VMRUN
+
+            const CODE: u16 = 0x009B; // present, S, type 0xB (execute/read, accessed)
+            const DATA: u16 = 0x0093; // present, S, type 0x3 (read/write, accessed)
+            v.seg(SEG_CS, 0, CODE, 0xFFFF, cs_base);
+            for off in [SEG_ES, SEG_SS, SEG_DS, SEG_FS, SEG_GS] {
+                v.seg(off, 0, DATA, 0xFFFF, 0);
+            }
+            v.seg(SEG_GDTR, 0, 0, 0xFFFF, 0);
+            v.seg(SEG_IDTR, 0, 0, 0xFFFF, 0);
+            v.seg(SEG_LDTR, 0, 0x0082, 0xFFFF, 0); // present, LDT
+            v.seg(SEG_TR, 0, 0x008B, 0xFFFF, 0); // present, busy TSS
+            *v.va.add(STATE_CPL) = 0;
+            v.w64(STATE_EFER, EFER_SVME); // VMRUN requires guest EFER.SVME
+            v.w64(STATE_CR0, 0x10); // ET; protection and paging off
+            v.w64(STATE_CR3, 0);
+            v.w64(STATE_CR4, 0);
+            v.w64(STATE_DR6, 0xFFFF_0FF0);
+            v.w64(STATE_DR7, 0x400);
+            v.w64(STATE_RFLAGS, 0x2);
+            v.w64(STATE_RIP, 0);
+            v.w64(STATE_RSP, 0);
+            v.w64(STATE_RAX, 0);
+            v.w64(STATE_G_PAT, 0x0007_0406_0007_0406);
+        }
+        Some(v)
+    }
+
+    /// Enter the guest until its next #VMEXIT; return the exit code.
+    fn run(&self) -> u64 {
+        unsafe {
+            // GIF cleared around VMRUN so no host interrupt lands mid-switch. The guest shares the
+            // host's general registers except RAX/RSP (saved by VMRUN); these test guests only
+            // write AX, so the others are marked clobbered as a precaution.
+            asm!(
+                "clgi",
+                "vmrun rax",
+                "stgi",
+                inout("rax") self.pa => _,
+                out("rcx") _, out("rdx") _, out("rsi") _, out("rdi") _,
+                out("r8") _, out("r9") _, out("r10") _, out("r11") _,
+                out("r12") _, out("r13") _, out("r14") _, out("r15") _,
+            );
+            self.r64(CTRL_EXITCODE)
+        }
+    }
+
+    fn log_exit(&self, test: &str) {
+        unsafe {
+            info!(
+                "iskra-svm: {}: #VMEXIT code {:#x} info1 {:#x} info2 {:#x}, guest rip {:#x} ax {:#x}",
+                test,
+                self.r64(CTRL_EXITCODE),
+                self.r64(CTRL_EXITINFO1),
+                self.r64(CTRL_EXITINFO2),
+                self.r64(STATE_RIP),
+                self.r64(STATE_RAX) & 0xFFFF
+            );
+        }
+    }
+
+    fn ax(&self) -> u64 {
+        unsafe { self.r64(STATE_RAX) & 0xFFFF }
+    }
 }
 
