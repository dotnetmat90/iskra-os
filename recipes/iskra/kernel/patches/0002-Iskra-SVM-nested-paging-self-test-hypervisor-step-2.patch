 /// Allocate a zeroed frame; return its physical address and kernel-virtual pointer.
 fn zeroed_page() -> Option<(u64, *mut u8)> {
     let frame = allocate_frame(true)?;
@@ -111,95 +203,164 @@ fn zeroed_page() -> Option<(u64, *mut u8)> {
     Some((phys.data() as u64, virt))
