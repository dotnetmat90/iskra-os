+fn virt(pa: u64) -> *mut u64 {
+    RmmA::phys_to_virt(crate::memory::PhysicalAddress::new(pa as usize)).data() as *mut u64
+}
+
+/// Four-level nested page table (same format as x86-64 long-mode paging), 4 KiB pages only.
+struct NestedPageTable {
+    pml4: u64,
+}
+
+impl NestedPageTable {
+    fn new() -> Option<Self> {
+        Some(Self { pml4: zeroed_page()?.0 })
+    }
+
+    /// Map guest-physical `gpa` to host-physical `hpa`, allocating intermediate tables.
+    fn map_4k(&self, gpa: u64, hpa: u64) -> Option<()> {
+        let mut table = self.pml4;
+        for shift in [39, 30, 21] {
+            let entry = unsafe { virt(table).add(((gpa >> shift) & 0x1FF) as usize) };
+            if unsafe { *entry } & 1 == 0 {
+                let (next, _) = zeroed_page()?;
+                unsafe { *entry = next | NPT_FLAGS };
+            }
+            table = unsafe { *entry } & 0x000F_FFFF_FFFF_F000;
+        }
+        unsafe { *virt(table).add(((gpa >> 12) & 0x1FF) as usize) = hpa | NPT_FLAGS };
+        Some(())
+    }
+}
+
