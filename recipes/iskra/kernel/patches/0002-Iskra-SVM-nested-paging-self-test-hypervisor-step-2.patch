+    // Guest-physical layout: 0x0000 code + data, 0x1000 guest page directory, 0x5000 unmapped.
+    //   0: B8 34 12 00 00   mov eax, 0x1234
+    //   5: A3 00 01 00 00   mov [0x100], eax
