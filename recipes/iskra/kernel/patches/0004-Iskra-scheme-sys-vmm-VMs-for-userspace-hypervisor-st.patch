index 00000000..91ea6d57
--- /dev/null
+++ b/src/scheme/sys/vmm.rs
@@ -0,0 +1,137 @@
+//! Iskra: `/scheme/sys/vmm`, the hypervisor interface for userspace (hypervisor step 4).
+//!
+//! Opening `/scheme/sys/vmm` (root only) creates one VM with one vCPU (AMD SVM, nested paging).
+//! The file offset selects what a read or write means:
+//!
+//! | offset              | write                                   | read                          |
+//! |---------------------|-----------------------------------------|-------------------------------|
+//! | `0 .. 1 TiB`        | guest memory at that guest-physical address (pages allocated on first write) | guest memory |
+//! | [`REGS`] (1 << 48)  | vCPU registers ([`VmRegs`])              | vCPU registers                |
+//! | [`RUN`]  (REGS + 4 KiB) | -                                    | run until the next exit, returns [`VmExit`] |
+//!
+//! The kernel intercepts interrupts, every I/O port, every MSR, CPUID and HLT, so a guest never
+//! reaches host hardware or host MSRs; userspace decides how to answer each exit. Closing the
+//! file destroys the VM and frees its memory. A simple VMM is therefore: pwrite code, pwrite
+//! registers, loop { pread RUN; handle exit; adjust registers }.
+//!
+//! [`VmRegs`]: crate::arch::svm::VmRegs
+//! [`VmExit`]: crate::arch::svm::VmExit
+
+use alloc::{boxed::Box, vec};
+
+use crate::{
+    sync::CleanLockToken,
+    syscall::{
+        error::{Error, Result, EBUSY, EINVAL, ENODEV},
+        usercopy::{UserSliceRo, UserSliceWo},
+    },
+};
+
+use super::{Handle, HANDLES};
+
+pub const REGS: u64 = 1 << 48;
+pub const RUN: u64 = REGS + 0x1000;
+/// Largest single memory read or write.
+const MAX_IO: usize = 1 << 20;
+
+#[cfg(all(target_arch = "x86_64", feature = "iskra_svm_selftest"))]
+mod imp {
+    pub use crate::arch::svm::{VM_GPA_LIMIT, Vm, VmExit, VmRegs};
+}
+
+/// A VM slot; `None` while a vCPU run has it checked out.
+#[cfg(all(target_arch = "x86_64", feature = "iskra_svm_selftest"))]
+pub type Slot = Option<Box<imp::Vm>>;
+#[cfg(not(all(target_arch = "x86_64", feature = "iskra_svm_selftest")))]
+pub type Slot = ();
+
+pub fn create() -> Result<Slot> {
+    #[cfg(all(target_arch = "x86_64", feature = "iskra_svm_selftest"))]
+    {
+        imp::Vm::new().map(|vm| Some(Box::new(vm))).ok_or(Error::new(ENODEV))
+    }
+    #[cfg(not(all(target_arch = "x86_64", feature = "iskra_svm_selftest")))]
+    {
+        Err(Error::new(ENODEV))
+    }
+}
+
+#[cfg(all(target_arch = "x86_64", feature = "iskra_svm_selftest"))]
+fn with_vm<R>(id: usize, token: &mut CleanLockToken, f: impl FnOnce(&mut imp::Vm) -> R) -> Result<R> {
+    let mut handles = HANDLES.write(token.token());
+    match handles.get_mut(id)? {
+        Handle::Vm(Some(vm)) => Ok(f(vm)),
+        Handle::Vm(None) => Err(Error::new(EBUSY)),
+        _ => Err(Error::new(EINVAL)),
+    }
+}
+
+pub fn read(id: usize, buf: UserSliceWo, pos: u64, token: &mut CleanLockToken) -> Result<usize> {
+    #[cfg(all(target_arch = "x86_64", feature = "iskra_svm_selftest"))]
+    {
+        use imp::*;
+        if pos == REGS {
+            let regs = with_vm(id, token, |vm| vm.regs())?;
+            return buf.copy_common_bytes_from_slice(bytes_of(&regs));
+        }
+        if pos == RUN {
+            // Check the VM out of the handle table so the lock is not held while the guest runs.
+            let mut vm = {
+                let mut handles = HANDLES.write(token.token());
+                match handles.get_mut(id)? {
+                    Handle::Vm(slot) => slot.take().ok_or(Error::new(EBUSY))?,
+                    _ => return Err(Error::new(EINVAL)),
+                }
+            };
+            let exit = vm.run();
+            if let Handle::Vm(slot) = HANDLES.write(token.token()).get_mut(id)? {
+                *slot = Some(vm);
+            }
+            let exit: VmExit = exit.ok_or(Error::new(ENODEV))?;
+            return buf.copy_common_bytes_from_slice(bytes_of(&exit));
+        }
+        if pos < VM_GPA_LIMIT {
+            let mut data = vec![0u8; buf.len().min(MAX_IO)];
+            with_vm(id, token, |vm| vm.read_mem(pos, &mut data))?;
+            return buf.copy_common_bytes_from_slice(&data);
+        }
+        Err(Error::new(EINVAL))
+    }
+    #[cfg(not(all(target_arch = "x86_64", feature = "iskra_svm_selftest")))]
+    {
+        let _ = (id, buf, pos, token);
+        Err(Error::new(ENODEV))
+    }
+}
+
+pub fn write(id: usize, buf: UserSliceRo, pos: u64, token: &mut CleanLockToken) -> Result<usize> {
+    #[cfg(all(target_arch = "x86_64", feature = "iskra_svm_selftest"))]
+    {
+        use imp::*;
+        if pos == REGS {
+            if buf.len() != core::mem::size_of::<VmRegs>() {
+                return Err(Error::new(EINVAL));
+            }
+            let regs: VmRegs = unsafe { buf.read_exact()? };
+            with_vm(id, token, |vm| vm.set_regs(&regs))?;
+            return Ok(core::mem::size_of::<VmRegs>());
+        }
+        if pos < VM_GPA_LIMIT {
+            let mut data = vec![0u8; buf.len().min(MAX_IO)];
+            let n = buf.copy_common_bytes_to_slice(&mut data)?;
+            with_vm(id, token, |vm| vm.write_mem(pos, &data[..n]))?.ok_or(Error::new(EINVAL))?;
+            return Ok(n);
+        }
+        Err(Error::new(EINVAL))
+    }
+    #[cfg(not(all(target_arch = "x86_64", feature = "iskra_svm_selftest")))]
+    {
+        let _ = (id, buf, pos, token);
+        Err(Error::new(ENODEV))
+    }
+}
+
+#[cfg(all(target_arch = "x86_64", feature = "iskra_svm_selftest"))]
+fn bytes_of<T: Copy>(value: &T) -> &[u8] {
+    unsafe { core::slice::from_raw_parts((value as *const T).cast::<u8>(), core::mem::size_of::<T>()) }
+}
