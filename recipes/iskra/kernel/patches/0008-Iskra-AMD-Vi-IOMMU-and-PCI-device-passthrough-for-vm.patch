+++ b/src/arch/x86_shared/amd_vi.rs
@@ -0,0 +1,193 @@
+//! Iskra: AMD-Vi (AMD I/O virtualization, the AMD IOMMU) for device passthrough (hypervisor step 8).
+//!
+//! Started lazily, the first time a VM is given a PCI device. Every device table entry starts
+//! invalid, which the IOMMU treats as "no translation": the host's own devices keep doing DMA
+//! exactly as before. Only a device assigned to a VM gets a valid entry, pointing at an I/O page
+//! table that maps guest-physical addresses to the VM's host frames, so the device can reach the
+//! guest's RAM and nothing else.
+//!
+//! Register and table layouts follow the AMD I/O Virtualization Technology (IOMMU) Specification
+//! (#48882): IVRS/IVHD (ch. 5), device table entry (2.2.2), I/O page tables (2.2.3), MMIO registers
+//! (3.4) and commands (2.4).
+//!
+//! ponytail: one IOMMU (the first IVHD), segment 0 only, no interrupt remapping, the event log is
+//! enabled but never read; add those when real AMD hardware or several IOMMUs need them.
+
+use core::ptr::{read_volatile, write_volatile};
+
+use spin::Mutex;
+
+use crate::{
+    acpi::find_sdt,
+    memory::{allocate_p2frame, PhysicalAddress, RmmA, RmmArch},
+    syscall::io::{Io, Pio},
+};
+
+const REG_DEV_TABLE: usize = 0x00;
+const REG_CMD_BUF: usize = 0x08;
+const REG_EVENT_LOG: usize = 0x10;
+const REG_CONTROL: usize = 0x18;
+const REG_CMD_TAIL: usize = 0x2008;
+const CTRL_IOMMU_EN: u64 = 1 << 0;
+const CTRL_EVENT_LOG_EN: u64 = 1 << 2;
+const CTRL_CMD_BUF_EN: u64 = 1 << 12;
+/// 4 KiB buffers of 256 16-byte entries (length field = log2(256)).
+const BUF_LEN_256: u64 = 8 << 56;
+
+const DTE_V: u64 = 1 << 0;
+const DTE_TV: u64 = 1 << 1;
+const DTE_MODE_4LEVEL: u64 = 4 << 9;
+/// Read and write permission, the same bits in device table and page table entries.
+pub const IO_RW: u64 = (1 << 61) | (1 << 62);
+pub const IO_PRESENT: u64 = 1;
+
+struct Iommu {
+    mmio: usize,
+    dev_table: usize,
+    cmd: usize,
+    cmd_tail: usize,
+    /// One word the IOMMU writes when a COMPLETION_WAIT is reached.
+    sem: usize,
+    sem_pa: u64,
+}
+
+static IOMMU: Mutex<Option<Iommu>> = Mutex::new(None);
+static PCI_CONFIG: Mutex<()> = Mutex::new(());
+
+fn zeroed(order: u32) -> Option<(u64, usize)> {
+    let frame = allocate_p2frame(order, true)?;
+    Some((frame.base().data() as u64, RmmA::phys_to_virt(frame.base()).data()))
+}
+
+impl Iommu {
+    fn start() -> Option<Self> {
+        let ivrs = *find_sdt("IVRS").first()?;
+        let table = unsafe {
+            core::slice::from_raw_parts(ivrs as *const _ as *const u8, ivrs.length as usize)
+        };
+        // IVRS header (36) + IVinfo (4) + reserved (8), then IVHD/IVMD blocks.
+        let mut off = 48;
+        let base = loop {
+            let block = table.get(off..off + 24)?;
+            let len = u16::from_le_bytes([block[2], block[3]]) as usize;
+            if matches!(block[0], 0x10 | 0x11 | 0x40) {
+                break u64::from_le_bytes(block[8..16].try_into().ok()?);
+            }
+            off += len.max(4);
+        };
+        let mmio = unsafe { crate::memory::map_device_memory(PhysicalAddress::new(base as usize), 0x4000) }.data();
+        let (dev_table_pa, dev_table) = zeroed(9)?; // 65536 entries x 32 bytes = 2 MiB
+        let (cmd_pa, cmd) = zeroed(0)?;
+        let (log_pa, _) = zeroed(0)?;
+        let (sem_pa, sem) = zeroed(0)?;
+        let iommu = Iommu { mmio, dev_table, cmd, cmd_tail: 0, sem, sem_pa };
+        unsafe {
+            iommu.w64(REG_DEV_TABLE, dev_table_pa | 0x1FF); // size: (0x1FF + 1) x 4 KiB
+            iommu.w64(REG_CMD_BUF, cmd_pa | BUF_LEN_256);
+            iommu.w64(REG_EVENT_LOG, log_pa | BUF_LEN_256);
+            let ctrl = iommu.r64(REG_CONTROL);
+            iommu.w64(REG_CONTROL, ctrl | CTRL_CMD_BUF_EN | CTRL_EVENT_LOG_EN);
+            iommu.w64(REG_CONTROL, ctrl | CTRL_CMD_BUF_EN | CTRL_EVENT_LOG_EN | CTRL_IOMMU_EN);
+        }
+        info!("iskra-amd-vi: IOMMU at {:#x} enabled (all devices untranslated)", base);
+        Some(iommu)
+    }
+
+    unsafe fn r64(&self, reg: usize) -> u64 {
+        unsafe { read_volatile((self.mmio + reg) as *const u64) }
+    }
+    unsafe fn w64(&self, reg: usize, v: u64) {
+        unsafe { write_volatile((self.mmio + reg) as *mut u64, v) }
+    }
+
+    fn command(&mut self, c: [u32; 4]) {
+        unsafe {
+            let slot = (self.cmd + self.cmd_tail) as *mut u32;
+            for (i, w) in c.iter().enumerate() {
+                write_volatile(slot.add(i), *w);
+            }
+            self.cmd_tail = (self.cmd_tail + 16) % 4096;
+            self.w64(REG_CMD_TAIL, self.cmd_tail as u64);
+        }
+    }
+
+    /// Queue COMPLETION_WAIT and spin until the IOMMU has processed every earlier command.
+    fn wait(&mut self) -> bool {
+        unsafe { write_volatile(self.sem as *mut u64, 0) };
+        let lo = (self.sem_pa as u32 & !7) | 1; // store the data word when done
+        self.command([lo, (self.sem_pa >> 32) as u32 | (1 << 28), 1, 0]);
+        for _ in 0..10_000_000 {
+            if unsafe { read_volatile(self.sem as *const u64) } == 1 {
+                return true;
+            }
+            core::hint::spin_loop();
+        }
+        false
+    }
+
+    fn set_dte(&mut self, device: u16, entry: [u64; 4], domain: u16) -> bool {
+        unsafe {
+            let dte = (self.dev_table + device as usize * 32) as *mut u64;
+            for i in (1..4).rev() {
+                write_volatile(dte.add(i), entry[i]);
+            }
+            write_volatile(dte, entry[0]); // the valid bit last
+        }
+        self.command([device as u32, 2 << 28, 0, 0]); // INVALIDATE_DEVTAB_ENTRY
+        // INVALIDATE_IOMMU_PAGES for the whole domain (S=1, PDE=1, address all ones).
+        self.command([0, domain as u32 | (3 << 28), 0xFFFF_F000 | 3, 0x7FFF_FFFF]);
+        self.wait()
+    }
+}
+
+/// Point `device` (bus << 8 | dev << 3 | fn) at the I/O page table `root` in `domain`.
+pub fn attach(device: u16, root: u64, domain: u16) -> bool {
+    let mut guard = IOMMU.lock();
+    if guard.is_none() {
+        *guard = Iommu::start();
+    }
+    let Some(iommu) = guard.as_mut() else { return false };
+    let dte = [root | DTE_MODE_4LEVEL | DTE_TV | DTE_V | IO_RW, domain as u64, 0, 0];
+    iommu.set_dte(device, dte, domain)
+}
+
+/// Give `device` back to the host: invalid entry, untranslated DMA again.
+pub fn detach(device: u16, domain: u16) {
+    if let Some(iommu) = IOMMU.lock().as_mut() {
+        iommu.set_dte(device, [0; 4], domain);
+    }
+}
+
+/// Map `iova` -> `hpa` (4 KiB) in the 4-level I/O page table at `root`. `alloc` provides zeroed
+/// table frames (physical address) and must remember them for freeing.
+pub fn map_4k(root: u64, iova: u64, hpa: u64, mut alloc: impl FnMut() -> Option<u64>) -> Option<()> {
+    let mut table = root;
+    for level in (2..=4u64).rev() {
+        let shift = 12 + 9 * (level - 1);
+        let entry = virt(table + ((iova >> shift) & 0x1FF) * 8);
+        if unsafe { read_volatile(entry) } & IO_PRESENT == 0 {
+            let next = alloc()?;
+            unsafe { write_volatile(entry, next | ((level - 1) << 9) | IO_RW | IO_PRESENT) };
+        }
+        table = unsafe { read_volatile(entry) } & 0x000F_FFFF_FFFF_F000;
+    }
+    unsafe { write_volatile(virt(table + ((iova >> 12) & 0x1FF) * 8), hpa | IO_RW | IO_PRESENT) };
+    Some(())
+}
+
+fn virt(pa: u64) -> *mut u64 {
+    RmmA::phys_to_virt(PhysicalAddress::new(pa as usize)).data() as *mut u64
+}
+
+/// PCI configuration mechanism #1 (ports 0xCF8/0xCFC), aligned dwords.
+pub fn pci_read(device: u16, reg: u8) -> u32 {
+    let _guard = PCI_CONFIG.lock();
+    Pio::<u32>::new(0xCF8).write(0x8000_0000 | (device as u32) << 8 | (reg as u32 & 0xFC));
+    Pio::<u32>::new(0xCFC).read()
+}
+
+pub fn pci_write(device: u16, reg: u8, value: u32) {
+    let _guard = PCI_CONFIG.lock();
+    Pio::<u32>::new(0xCF8).write(0x8000_0000 | (device as u32) << 8 | (reg as u32 & 0xFC));
+    Pio::<u32>::new(0xCFC).write(value);
+}
