+    fn domain(&self) -> u16 {
+        // One device per VM, so the device names the domain: 1..=255 (0 unused; QEMU's AMD-Vi
+        // model also rejects DTEs with bit 8 set in the domain-ID word).
+        self.device.map_or(0, |(bdf, _)| bdf % 255 + 1)
+    }
+
+    /// Give PCI device `bdf` to this guest: its DMA goes through the IOMMU to the guest's RAM
+    /// (guest-physical addresses), and only there. Populate guest RAM first; pages added later are
+    /// mapped too.
+    pub fn assign_device(&mut self, bdf: u16) -> Option<()> {
+        if self.device.is_some() {
+            return None;
+        }
+        let root = allocate_frame(true)?;
+        self.owned.push((root, 0));
+        let root = root.base().data() as u64;
+        let pages: Vec<(u64, u64)> =
+            self.pages.iter().map(|(gpa, f)| (*gpa, f.base().data() as u64)).collect();
+        for (gpa, hpa) in pages {
+            self.io_map(root, gpa, hpa)?;
+        }
+        self.device = Some((bdf, root));
+        if !super::amd_vi::attach(bdf, root, self.domain()) {
+            self.device = None;
+            return None;
+        }
+        Some(())
+    }
+
+    fn io_map(&mut self, root: u64, gpa: u64, hpa: u64) -> Option<()> {
+        let owned = &mut self.owned;
+        super::amd_vi::map_4k(root, gpa, hpa, || {
+            let f = allocate_frame(true)?;
+            owned.push((f, 0));
+            Some(f.base().data() as u64)
+        })
+    }
+
+    /// Let the guest use host I/O ports `base..base + len` directly (no exits). Only inside an
+    /// I/O BAR of the assigned device.
+    pub fn allow_ports(&mut self, base: u64, len: u64) -> Option<()> {
+        let (bdf, _) = self.device?;
+        let inside_bar = (0..6).any(|i| {
+            let bar = super::amd_vi::pci_read(bdf, 0x10 + 4 * i);
+            bar & 1 == 1 && (bar & !3) as u64 == base
+        });
+        (inside_bar && len > 0 && len <= 256 && base + len <= 0x10000).then_some(())?;
+        let map = RmmA::phys_to_virt(PhysicalAddress::new(self.iopm as usize)).data() as *mut u8;
+        for port in base..base + len {
+            unsafe { *map.add(port as usize / 8) &= !(1 << (port % 8)) };
+        }
+        Some(())
+    }
+
+    /// Map the assigned device's memory BAR at host-physical `base` (`len` bytes) into the guest at
+    /// the same address, uncached, so the guest drives the device's registers directly.
+    pub fn map_mmio(&mut self, base: u64, len: u64) -> Option<()> {
+        let (bdf, _) = self.device?;
+        let is_bar = (0..6u8).any(|i| {
+            let lo = super::amd_vi::pci_read(bdf, 0x10 + 4 * i);
+            let hi = if lo & 0x7 == 0x4 && i < 5 { super::amd_vi::pci_read(bdf, 0x14 + 4 * i) } else { 0 };
+            lo & 1 == 0 && ((hi as u64) << 32 | (lo & !0xF) as u64) == base
+        });
+        let ok = is_bar && base != 0 && base % 4096 == 0 && len > 0 && len % 4096 == 0 && len <= 64 << 20;
+        ok.then_some(())?;
+        let (base, end) = (base, base.checked_add(len).filter(|e| *e <= VM_GPA_LIMIT)?);
+        for gpa in (base..end).step_by(4096) {
+            let mut table = self.npt;
+            for shift in [39, 30, 21] {
+                let entry = unsafe { virt(table).add(((gpa >> shift) & 0x1FF) as usize) };
+                if unsafe { *entry } & 1 == 0 {
+                    let next = allocate_frame(true)?;
+                    self.owned.push((next, 0));
+                    unsafe { *entry = next.base().data() as u64 | NPT_FLAGS };
+                }
+                table = unsafe { *entry } & 0x000F_FFFF_FFFF_F000;
+            }
+            // PCD | PWT: uncached, as device registers need.
+            unsafe { *virt(table).add(((gpa >> 12) & 0x1FF) as usize) = gpa | NPT_FLAGS | (1 << 4) | (1 << 3) };
+        }
+        Some(())
+    }
+
+    /// Configuration space of the assigned device (aligned dwords).
+    pub fn device_config(&self, reg: u8, write: Option<u32>) -> Option<u32> {
+        let (bdf, _) = self.device?;
+        match write {
+            Some(v) => {
+                super::amd_vi::pci_write(bdf, reg, v);
+                Some(v)
+            }
+            None => Some(super::amd_vi::pci_read(bdf, reg)),
+        }
+    }
+
