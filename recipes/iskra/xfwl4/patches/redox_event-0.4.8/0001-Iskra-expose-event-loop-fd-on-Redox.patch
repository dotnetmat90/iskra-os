From 5fc12c46012de13ee296c243364014a37ade8a38 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Wed, 25 Nov 2026 23:09:27 +0100
Subject: [PATCH 1/2] Iskra: expose event loop fd on Redox

---
 src/wrappers.rs | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/wrappers.rs b/src/wrappers.rs
index e8e2d7f..7b55253 100644
--- a/src/wrappers.rs
+++ b/src/wrappers.rs
@@ -176,3 +176,15 @@ impl<U: UserData> Iterator for EventQueue<U> {
 
 unsafe impl<U: UserData> Send for EventQueue<U> {}
 unsafe impl<U: UserData> Sync for EventQueue<U> {}
+
+// Iskra: let other event loops (calloop via winit) watch this queue.
+impl std::os::fd::AsRawFd for RawEventQueue {
+    fn as_raw_fd(&self) -> std::os::fd::RawFd {
+        self.inner as std::os::fd::RawFd
+    }
+}
+impl<U: UserData> std::os::fd::AsRawFd for EventQueue<U> {
+    fn as_raw_fd(&self) -> std::os::fd::RawFd {
+        self.inner.as_raw_fd()
+    }
+}
