From 93debf5bfd2f86a64e3afde7f9e8aa622c76794c Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Wed, 25 Nov 2026 23:09:27 +0100
Subject: [PATCH 1/2] Iskra: expose event loop fd on Redox

---
 src/event_loop.rs | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/event_loop.rs b/src/event_loop.rs
index caa998d..651f55b 100644
--- a/src/event_loop.rs
+++ b/src/event_loop.rs
@@ -902,3 +902,15 @@ pub struct PlatformSpecificEventLoopAttributes {}
 fn min_timeout(a: Option<Duration>, b: Option<Duration>) -> Option<Duration> {
     a.map_or(b, |a_timeout| b.map_or(Some(a_timeout), |b_timeout| Some(a_timeout.min(b_timeout))))
 }
+
+// Iskra: expose the event queue so smithay/calloop can poll this loop (with pump_app_events).
+impl std::os::fd::AsRawFd for EventLoop {
+    fn as_raw_fd(&self) -> std::os::fd::RawFd {
+        std::os::fd::AsRawFd::as_raw_fd(&*self.window_target.event_socket)
+    }
+}
+impl std::os::fd::AsFd for EventLoop {
+    fn as_fd(&self) -> std::os::fd::BorrowedFd<'_> {
+        unsafe { std::os::fd::BorrowedFd::borrow_raw(std::os::fd::AsRawFd::as_raw_fd(self)) }
+    }
+}
